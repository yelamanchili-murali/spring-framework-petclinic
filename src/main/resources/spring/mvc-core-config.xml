<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring MVC Core Configuration - DispatcherServlet application context for PetClinic web tier
  
  Key Configuration Areas:
  - Component scanning for web controllers and formatters
  - MVC annotation-driven configuration with custom conversion services
  - Static resource handling for CSS, JS, images and WebJars
  - View resolution and internationalization support
  - Exception handling and error page mapping
  
  Security Considerations:
  - Static resource mappings should be carefully controlled
  - Exception handling prevents stack trace exposure to users
  - Message source configuration supports internationalization
  
  Performance Optimizations:
  - Resource caching strategies for static content
  - WebJars integration for client-side dependency management
  - Component scanning limited to web package for faster startup
  
  Integration Points:
  - Imports mvc-view-config.xml for view resolver configuration
  - Coordinates with business-config.xml for service layer beans
  - Uses datasource-config.xml for persistence layer setup
-->
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/mvc
        http://www.springframework.org/schema/mvc/spring-mvc.xsd
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">

    <import resource="mvc-view-config.xml"/>

    <!-- Component Scanning: Auto-detect controllers and web components -->
    <!-- Scoped to web package for performance - service layer components loaded in business-config.xml -->
    <context:component-scan
        base-package="org.springframework.samples.petclinic.web"/>

    <!-- Enable MVC annotations with custom conversion service for form binding -->
    <!-- Provides automatic JSON/XML marshalling, validation, and type conversion -->
    <mvc:annotation-driven conversion-service="conversionService"/>

    <!-- Static Resource Handling: CSS, JS, Images from webapp/resources directory -->
    <!-- Enables browser caching and efficient resource delivery -->
    <mvc:resources mapping="/resources/**" location="/resources/"/>

    <!-- WebJars Integration: Client-side dependencies managed through Maven -->
    <!-- Allows Bootstrap, jQuery, etc. to be included as Maven dependencies -->
    <!-- TODO: Add cache headers for production deployment optimization -->
    <mvc:resources mapping="/webjars/**" location="classpath:/META-INF/resources/webjars/"/>

    <!-- Default View Controller: Maps root URL to welcome page -->
    <!-- Avoids need for dedicated controller method for simple page display -->
    <mvc:view-controller path="/" view-name="welcome"/>

    <!-- Default Servlet Handler: Serves static content when DispatcherServlet handles all requests -->
    <!-- Critical when servlet-mapping is '/' - delegates non-Spring requests to container -->
    <mvc:default-servlet-handler/>

    <bean id="conversionService" class="org.springframework.format.support.FormattingConversionServiceFactoryBean">
        <property name="formatters">
            <set>
                <bean class="org.springframework.samples.petclinic.web.PetTypeFormatter"/>
            </set>
        </property>
    </bean>

    <!--
        - Message source for this context, loaded from localized "messages_xx" files.
        - Files are stored inside src/main/resources
    -->
    <bean id="messageSource" class="org.springframework.context.support.ResourceBundleMessageSource"
          p:basename="messages/messages"/>

    <!--
        - This bean resolves specific types of exceptions to corresponding logical
        - view names for error views.
    -->
    <bean class="org.springframework.web.servlet.handler.SimpleMappingExceptionResolver">
        <!-- view name resolved using bean of type InternalResourceViewResolver (declared in mvc-view-config.xml) -->
        <property name="defaultErrorView" value="exception"/>
        <!-- results into 'WEB-INF/jsp/exception.jsp' -->
        <property name="warnLogCategory" value="warn"/>
        <!-- needed otherwise exceptions won't be logged anywhere -->
    </bean>

</beans>
